---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/layout/Hero.astro';
import Accordion from '../components/ui/Accordion.astro';
import QuickAnswer from '../components/content/QuickAnswer.astro';
import { breadcrumbs, webApplication } from '../lib/seo';
import { SITE } from '../data/site';

const faqs = [
  {
    q: 'How do I test my monitor or screen for dead pixels?',
    a: 'Use our online screen test to display fullscreen solid colors. Inspect the screen carefully under black, white, red, green, and blue. Dead pixels appear as small unlit dark spots against white, while stuck pixels appear as bright colored dots on black.',
  },
  {
    q: 'Can a dead pixel spread across the screen?',
    a: 'No. Dead pixels are individual transistor failures and do not spread like a virus. However, physical pressure or impact can damage neighboring pixels.',
  },
  {
    q: 'Does monitor warranty cover 1 dead pixel?',
    a: 'Most manufacturers follow ISO 13406-2 Class II standards, requiring 3 to 5 dead or stuck pixels before authorizing an RMA replacement. Check your manufacturer’s exact warranty terms.',
  },
];

const jsonLd = [
  webApplication({
    name: 'Online Dead Pixel Checker',
    url: `${SITE.url}/dead-pixel-test`,
    description:
      'Free online dead pixel test. Inspect your monitor, laptop, or phone display for dead and stuck pixels with fullscreen solid colors. 100% free.',
    featureList: [
      'Fullscreen dead pixel color test',
      'Solid Black, White, Red, Green, and Blue test patterns',
      'Stuck pixel revival tool',
      'Compatible with PC, Mac, iPad, iPhone, and Android displays',
    ],
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  breadcrumbs([{ name: 'Dead Pixel Test', href: '/dead-pixel-test' }]),
];
---

<Layout
  rawTitle="Dead Pixel Test: Free Online Monitor & Screen Checker"
  description="Free online dead pixel test. Check your computer monitor, laptop, or phone display for dead and stuck pixels with full-screen test colors. 100% private."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="Display test"
    title="Dead pixel test for monitors & laptops."
    subtitle="Detect dead, stuck, and hot pixels on any screen. Fullscreen inspection mode with zero downloads."
  />

  <Container class="-mt-8 pb-12 md:-mt-12">
    <div class="rounded-xl border border-hairline bg-canvas p-6 text-center elev-2">
      <p class="body-md text-body">
        Launch our interactive fullscreen display test:
      </p>
      <a
        href="/screen-test"
        class="mt-4 inline-flex items-center gap-2 rounded-pill bg-primary px-6 py-3 text-on-primary font-medium hover:opacity-90 transition-opacity"
      >
        <span>Launch Fullscreen Screen & Dead Pixel Test →</span>
      </a>
    </div>

    <QuickAnswer
      question="What is the fastest way to check for dead pixels?"
      answer="Switch your entire monitor to solid white, black, red, green, and blue backgrounds. A dead pixel will be unable to display color, showing as a permanent black or discolored speck."
    />

    <div class="mt-12">
      <h2 class="display-md text-ink text-center">Dead Pixel FAQ</h2>
      <div class="mx-auto mt-6 max-w-3xl">
        <Accordion items={faqs} />
      </div>
    </div>
  </Container>
</Layout>
