---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/layout/Hero.astro';
import WebcamTest from '../components/tool/WebcamTest.astro';
import Accordion from '../components/ui/Accordion.astro';
import Card from '../components/ui/Card.astro';
import QuickAnswer from '../components/content/QuickAnswer.astro';
import { breadcrumbs, webApplication } from '../lib/seo';
import { SITE } from '../data/site';

const mirrorFaqs = [
  {
    q: 'How does this online webcam mirror work?',
    a: 'Click "Start test" above to activate your camera. By default, your preview is automatically mirrored horizontally so it feels natural, just like looking into a physical bathroom or vanity mirror. Everything runs privately on your device—nothing is uploaded.',
  },
  {
    q: 'Why do video call apps mirror my video, but others see me unmirrored?',
    a: 'Human brains are accustomed to seeing their reflection in mirrors. If video apps like Zoom or Google Meet did not mirror your own self-view, moving your right hand would look like your left on screen, causing cognitive dissonance. However, the other attendees on the call see you unmirrored (the way other people see you in real life).',
  },
  {
    q: 'Can I flip the mirror to see how other people see me?',
    a: 'Yes! Click the "Mirror preview" button located below the video frame to toggle between mirrored (reflection view) and unmirrored (true view).',
  },
  {
    q: 'Can I make this webcam mirror full screen?',
    a: 'Yes. Click the "Fullscreen" button under the preview to expand the mirror across your entire display. Press Escape at any time to exit fullscreen mode.',
  },
];

const jsonLd = [
  webApplication({
    name: 'Online Webcam Mirror',
    url: `${SITE.url}/mirror`,
    description: 'Free online webcam mirror. Check your appearance, hair, and lighting in full-screen with horizontal flip toggle. 100% private.',
    featureList: [
      'Instant full-screen webcam mirror',
      'Horizontal mirror flip toggle (reflection vs true view)',
      'Lighting and appearance check before meetings',
      'Zero download, zero tracking, runs 100% in your browser',
    ],
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: mirrorFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  breadcrumbs([{ name: 'Webcam Mirror', href: '/mirror' }]),
];
---

<Layout
  rawTitle="Webcam Mirror: Free Online Fullscreen Camera Mirror"
  description="Free online webcam mirror. Check your appearance, teeth, hair, and lighting with a fullscreen in-browser mirror. Horizontal flip toggle included."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="Instant Mirror Tool"
    title="Online webcam mirror"
    subtitle="Use your computer or phone camera as an instant full-screen mirror to check your appearance, framing, and lighting privately."
  />

  <Container class="-mt-8 pb-6 md:-mt-12">
    <WebcamTest focus="full" />
  </Container>

  <QuickAnswer>
    To use this page as a mirror, click <strong>Start test</strong> above. The video preview automatically mirrors your movement so it feels natural, exactly like looking into glass. You can click <strong>Fullscreen</strong> to expand the reflection across your entire monitor, or click <strong>Mirror preview</strong> to toggle between your mirror reflection and the true view other people see.
  </QuickAnswer>

  <Container class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <p class="caption-mono uppercase text-mute">Appearance Guide</p>
      <h2 class="display-lg mt-3 text-ink">How to look your best before video calls</h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <Card class="p-5">
          <h3 class="display-sm text-ink">1. Check True View vs Mirror View</h3>
          <p class="body-sm mt-2 text-body">
            Toggle the mirror button to see how text, logos, or notes look to other attendees. Mirrored view is ideal for grooming, while true view ensures your background and shirt text read correctly.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">2. Dial In Your Lighting</h3>
          <p class="body-sm mt-2 text-body">
            Look for harsh shadows under your eyes or nose. Move your desk lamp slightly higher and to the side, or face a natural window to create soft, flattering, even facial illumination.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">3. Position at Eye Level</h3>
          <p class="body-sm mt-2 text-body">
            Avoid looking down into your laptop camera, which accentuates double chins and low ceiling fans. Raise your laptop screen so the camera lens sits directly parallel with your eyes.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">4. Background &amp; Contrast</h3>
          <p class="body-sm mt-2 text-body">
            Ensure your clothes contrast with your background wall so you don't blend into the room. Check that there is no distracting movement or clutter in your frame.
          </p>
        </Card>
      </div>

      <!-- FAQ Section -->
      <div class="mt-14">
        <h2 class="display-md text-ink">Webcam mirror questions &amp; answers</h2>
        <div class="mt-6">
          <Accordion items={mirrorFaqs} />
        </div>
      </div>
    </div>
  </Container>
</Layout>
