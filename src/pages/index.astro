---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/layout/Hero.astro';
import WebcamTest from '../components/tool/WebcamTest.astro';
import Accordion from '../components/ui/Accordion.astro';
import Card from '../components/ui/Card.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import HomeGuide from '../components/content/HomeGuide.astro';
import { HOME_FAQS } from '../data/faqs';
import { SITE } from '../data/site';

const steps = [
  {
    name: 'Press “Start test”',
    text: 'No download, no plugin, no account. The test opens your camera through your browser’s standard media API, exactly as a video call would.',
  },
  {
    name: 'Allow camera access',
    text: 'Your browser asks for permission — it always does, for every site. Choose Allow and your preview appears within a second or two.',
  },
  {
    name: 'Read your results',
    text: 'Resolution, frame rate, aspect ratio and lighting are measured live, and anything that would look poor on a call is flagged with a specific fix.',
  },
];

const checks = [
  {
    title: 'Resolution',
    body: 'Your live resolution and the maximum your camera supports, so you know whether you are getting the quality you paid for.',
  },
  {
    title: 'Frame rate',
    body: 'Counted from the frames your browser actually presents, rather than the figure quoted on the box.',
  },
  {
    title: 'Aspect ratio',
    body: 'Whether your camera delivers the 16:9 shape conferencing apps expect, or a 4:3 image they will crop.',
  },
  {
    title: 'Bitrate',
    body: 'Measured by encoding a short sample, so the number reflects what your camera really produces.',
  },
  {
    title: 'Image quality',
    body: 'Brightness, contrast, saturation and colour count are sampled live, and we flag a picture that is too dark or blown out.',
  },
  {
    title: 'Microphone',
    body: 'A live input meter shows what callers would hear, so you can set your level before anyone is listening.',
  },
  {
    title: 'Speakers',
    body: 'A test tone through the left and right channels confirms the other half of the call actually works.',
  },
  {
    title: 'Record and play back',
    body: 'Capture a few seconds and watch it back — the only honest way to see what other people see.',
  },
  {
    title: 'Permissions and devices',
    body: 'Confirms the browser granted access over a secure connection, and lists every camera and microphone to switch between.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    url: SITE.url,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern browser with camera access (Chrome, Edge, Firefox, Safari).',
    description: SITE.description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to test your webcam online',
    description:
      'Test a webcam in your browser in three steps, with no downloads and nothing uploaded.',
    totalTime: 'PT1M',
    step: steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
      url: `${SITE.url}/#how-it-works`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: HOME_FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const trust = [
  { label: 'No downloads', icon: 'M12 3v12m0 0 4-4m-4 4-4-4M4 21h16' },
  { label: 'No sign-up', icon: 'M20 6 9 17l-5-5' },
  { label: 'Runs in your browser', icon: 'M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20' },
  { label: 'Nothing uploaded', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z' },
];
---

<Layout
  rawTitle="Webcam Test — Free Online Webcam & Mic Test (No Download)"
  description="Free online webcam test. Check your camera and mic in your browser — resolution, FPS, bitrate and image quality. No download, no sign-up, nothing uploaded."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="100% private · runs in your browser"
    title="Webcam test, done in seconds."
    subtitle="Preview your camera, measure resolution and frame rate, and run instant health checks before your next call. Nothing ever leaves your device."
  >
    <!--
      A centred flex-wrap left these four on two ragged rows with no shared left
      edge on phones (each row centres independently). A fixed 2-column grid gives
      them a real gutter to line up on; from sm there is room for a single centred
      row and the flex behaviour comes back.

      The column has to be wide enough for the longest label ("Runs in your
      browser") to stay on one line, otherwise that one cell wraps, its grid row
      grows to two lines and the pair stops lining up. Two columns only fit that
      label from ~400px up, so below that the list is a single centred column —
      four aligned rows beat two ragged ones. items-start keeps the icon on the
      label's first line if a longer label is ever added.
    -->
    <div class="mx-auto grid w-fit grid-cols-1 gap-y-3 min-[400px]:w-full min-[400px]:max-w-sm min-[400px]:grid-cols-2 min-[400px]:gap-x-3 sm:flex sm:max-w-none sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-6 sm:gap-y-2">
      {
        trust.map((t) => (
          <span class="body-sm flex items-start gap-2 text-left text-body sm:items-center">
            <svg class="mt-0.5 size-4 shrink-0 text-ink sm:mt-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={`<path d="${t.icon}" />`} />
            {t.label}
          </span>
        ))
      }
    </div>
  </Hero>

  <Container class="-mt-8 pb-6 md:-mt-12" id="test">
    <WebcamTest focus="full" />
  </Container>

  <!-- How it works -->
  <Container class="py-12 sm:py-16" id="how-it-works">
    <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-10">
      <h2 class="display-lg text-ink">Three steps, about a minute.</h2>
      <p class="body-md mt-3 text-body">
        There is nothing to install and nothing to sign up for. The camera opens, the numbers
        appear, and you close the tab.
      </p>
    </div>
    <ol class="grid gap-4 md:grid-cols-3">
      {
        steps.map((s, i) => (
          <li>
            <Card class="h-full p-6" elevation={2}>
              <span class="grid size-9 place-items-center rounded-full bg-primary text-on-primary" aria-hidden="true">
                <span class="body-sm font-semibold">{i + 1}</span>
              </span>
              <h3 class="display-sm mt-4 text-ink">{s.name}</h3>
              <p class="body-sm mt-2 text-body">{s.text}</p>
            </Card>
          </li>
        ))
      }
    </ol>
  </Container>

  <!-- What gets checked -->
  <Container class="py-12 sm:py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-10">
      <h2 class="display-lg text-ink">What the test actually checks.</h2>
      <p class="body-md mt-3 text-body">
        Seeing your own face confirms the camera turns on. These are the things that decide
        whether you look and sound good to everyone else.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        checks.map((c) => (
          <Card class="p-6" elevation={2}>
            <h3 class="display-sm text-ink">{c.title}</h3>
            <p class="body-sm mt-2 text-body">{c.body}</p>
          </Card>
        ))
      }
    </div>
  </Container>

  <!-- Sub-tools -->
  <Container class="py-12 sm:py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center sm:mb-10">
      <h2 class="display-lg text-ink">Go deeper on any dimension.</h2>
      <p class="body-md mt-3 text-body">Focused tools for the checks that matter most before a meeting or stream.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <FeatureCard
        title="Resolution test"
        href="/resolution"
        icon={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="14" x="3" y="5" rx="2"/><path d="M3 10h18"/></svg>`}
      >
        See your live and maximum supported resolution, and whether it is HD-ready.
      </FeatureCard>
      <FeatureCard
        title="FPS test"
        href="/fps"
        icon={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><circle cx="12" cy="14" r="8"/><path d="M12 14v-3"/></svg>`}
      >
        Measure real frame rate from the frames your browser actually presents.
      </FeatureCard>
      <FeatureCard
        title="Microphone test"
        href="/mic-test"
        icon={`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`}
      >
        Check your mic with a live input level meter — no call required.
      </FeatureCard>
    </div>
  </Container>

  <!-- Not working -->
  <Container class="py-12 sm:py-16">
    <div class="rounded-xl border border-hairline bg-canvas p-6 elev-3 sm:p-8 md:p-12">
      <div class="grid items-center gap-6 md:grid-cols-[1fr_auto] md:gap-8">
        <div>
          <p class="caption-mono uppercase text-mute">Camera not working?</p>
          <h2 class="display-md mt-3 text-ink">Four causes explain almost every failure.</h2>
          <p class="body-md mt-3 max-w-xl text-body">
            A blocked permission, another app holding the camera, the wrong device selected, or
            a privacy shutter over the lens. Our troubleshooting guide walks through each one,
            with the exact settings path for every major browser and for Windows and macOS.
          </p>
        </div>
        <a
          href="/troubleshooting"
          class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-pill bg-primary px-6 py-3 text-on-primary transition-opacity hover:opacity-90 md:w-auto"
        >
          <span class="body-sm font-medium">Open the fix-it guide</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </Container>

  <!-- Privacy strip -->
  <Container>
    <div class="rounded-xl border border-hairline bg-primary p-6 text-on-primary elev-4 sm:p-8 md:p-12">
      <div class="grid items-center gap-6 md:grid-cols-[1fr_auto]">
        <div>
          <p class="caption-mono uppercase text-on-primary/50">Privacy by design</p>
          <h2 class="display-md mt-3 text-on-primary">Your camera feed never leaves your device.</h2>
          <p class="body-md mt-3 max-w-xl text-on-primary/70">
            Every check runs locally in your browser using standard web APIs. We never
            receive, store or transmit your video or audio — and the optional clip you can
            record stays in your browser on your own device.
          </p>
        </div>
        <a href="/privacy" class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-pill bg-canvas px-6 py-3 text-ink transition-opacity hover:opacity-90 md:w-auto">
          <span class="body-sm font-medium">Read our privacy approach</span>
        </a>
      </div>
    </div>
  </Container>

  <HomeGuide />

  <!-- FAQ -->
  <Container class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <h2 class="display-lg text-center text-ink">Webcam test FAQ</h2>
      <div class="mt-8">
        <Accordion items={HOME_FAQS} />
      </div>
      <p class="body-md mt-6 text-center text-body">
        More questions answered in the{' '}
        <a class="text-link hover:text-link-deep" href="/faq">full webcam test FAQ</a> — how to test
        a webcam on Windows 11, Windows 10, Mac and laptops, and how to find what is using your camera.
      </p>
    </div>
  </Container>
</Layout>
