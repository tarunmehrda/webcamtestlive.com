---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Hero from '../components/layout/Hero.astro';
import WebcamTest from '../components/tool/WebcamTest.astro';
import Accordion from '../components/ui/Accordion.astro';
import Card from '../components/ui/Card.astro';
import QuickAnswer from '../components/content/QuickAnswer.astro';
import { breadcrumbs, webApplication } from '../lib/seo';
import { SITE } from '../data/site';

const photoFaqs = [
  {
    q: 'How do I take a photo using my webcam online?',
    a: 'Click "Start test" above to open your camera preview. Center yourself within the frame and click the "Take snapshot" button with the camera icon. Your browser will instantly capture a high-resolution PNG image and automatically save it to your Downloads folder.',
  },
  {
    q: 'Are my snapshots uploaded to any server or saved online?',
    a: 'No. The image capture process uses HTML5 Canvas and runs 100% locally on your computer or phone. Your pictures are generated in memory and downloaded straight to your disk without ever being sent across the internet.',
  },
  {
    q: 'What resolution will my photos be taken in?',
    a: 'Your photos are captured at the exact maximum pixel resolution your webcam hardware delivers (e.g. 1280x720 HD, 1920x1080 Full HD, or 4K). You can view your current resolution directly below the camera stage.',
  },
  {
    q: 'Can I flip or mirror the photo before taking it?',
    a: 'Yes. Use the "Mirror preview" button to switch between mirrored reflection mode and unmirrored mode before clicking "Take snapshot".',
  },
];

const jsonLd = [
  webApplication({
    name: 'Online Webcam Photo Taker',
    url: `${SITE.url}/take-photo`,
    description: 'Take high-resolution photos and snapshots with your webcam online for free. Download crystal-clear PNG images with zero uploads.',
    featureList: [
      'One-click instant webcam snapshot capture',
      'Download Full HD PNG pictures directly to device',
      'Mirror and unmirror image controls',
      '100% private client-side processing without server storage',
    ],
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: photoFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  breadcrumbs([{ name: 'Take Photo Online', href: '/take-photo' }]),
];
---

<Layout
  rawTitle="Take Photo with Webcam Online: Free Camera Snapshot Tool"
  description="Take photos online with your webcam for free. Capture crystal-clear snapshots and download PNG images instantly in your browser with zero uploads."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="Webcam Snapshot Tool"
    title="Take a photo with your webcam online"
    subtitle="Capture instant high-resolution snapshots from your computer or phone camera and download them directly without installing software."
  />

  <Container class="-mt-8 pb-6 md:-mt-12">
    <WebcamTest focus="full" />
  </Container>

  <QuickAnswer>
    To take a picture with your webcam, press <strong>Start test</strong> above and allow camera permissions. Frame yourself comfortably on screen and click <strong>Take snapshot</strong>. Your photo will instantly capture at full camera resolution (720p, 1080p, or 4K) and download to your computer as a clean PNG image without watermarks.
  </QuickAnswer>

  <Container class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <p class="caption-mono uppercase text-mute">Snapshot Tips</p>
      <h2 class="display-lg mt-3 text-ink">How to capture sharp webcam portraits</h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <Card class="p-5">
          <h3 class="display-sm text-ink">1. Hold Still for Maximum Sharpness</h3>
          <p class="body-sm mt-2 text-body">
            Webcams use electronic rolling shutters. Pausing movement for half a second right before pressing the snapshot button prevents motion blur and keeps hair and facial features crisp.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">2. Maximize Ambient Light</h3>
          <p class="body-sm mt-2 text-body">
            Webcam sensors are small. In dim environments, camera software boosts sensor gain, introducing heavy digital grain. Bright, diffuse lighting allows the sensor to capture maximum color fidelity.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">3. Clean Your Camera Lens</h3>
          <p class="body-sm mt-2 text-body">
            Laptop and monitor camera lenses easily collect fingerprints and airborne dust, causing hazy contrast. Gently wiping the glass with a microfiber cloth immediately sharpens image capture.
          </p>
        </Card>

        <Card class="p-5">
          <h3 class="display-sm text-ink">4. Check Alignment with Grid Guides</h3>
          <p class="body-sm mt-2 text-body">
            Turn on the framing guides overlay to ensure your head sits vertically centered and level. This is great for profile pictures, passport drafts, and document verification captures.
          </p>
        </Card>
      </div>

      <!-- FAQ Section -->
      <div class="mt-14">
        <h2 class="display-md text-ink">Webcam photo questions &amp; answers</h2>
        <div class="mt-6">
          <Accordion items={photoFaqs} />
        </div>
      </div>
    </div>
  </Container>
</Layout>
