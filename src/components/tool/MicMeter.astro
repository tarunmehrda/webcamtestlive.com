---
import { t, localeFromPath } from '../../i18n';
const c = t(localeFromPath(Astro.url.pathname)).tool.mic;
interface Props {
  standalone?: boolean;
}
const { standalone = true } = Astro.props;
---

<section
  class="relative z-10 w-full"
  data-mic-tool
  data-strings={JSON.stringify({ idle: c.idle, listening: c.listening })}
>
  <div class="rounded-xl border border-hairline bg-canvas p-6 elev-3">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 class="display-sm text-ink">{c.meterTitle}</h2>
        <p class="body-sm mt-1 text-body">{c.meterSubtitle}</p>
      </div>
      <span
        data-mic-status
        class="caption-mono rounded-full border border-hairline bg-canvas-soft px-2.5 py-1 text-mute"
        >{c.idle}</span
      >
    </div>

    <!-- meter -->
    <div class="mt-6">
      <div class="h-4 w-full overflow-hidden rounded-full bg-canvas-soft-2">
        <div
          data-mic-level
          class="h-full w-0 rounded-full bg-gradient-to-r from-success via-warning to-error transition-[width] duration-75"
        ></div>
      </div>
      <div class="mt-2 flex justify-between">
        <span class="caption-mono text-mute">Silent</span>
        <span class="caption-mono text-mute">Loud</span>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button
        data-mic-start
        class="inline-flex items-center gap-2 rounded-pill bg-primary px-5 py-3 sm:py-2.5 text-on-primary transition-opacity hover:opacity-90"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" /><path d="M19 10v2a7 7 0 0 1-14 0v-2" /><line x1="12" x2="12" y1="19" y2="22" />
        </svg>
        <span class="body-sm font-medium">Test microphone</span>
      </button>
      <button
        data-mic-stop
        class="hidden items-center gap-2 rounded-pill border border-hairline bg-canvas px-5 py-3 sm:py-2.5 text-ink transition-colors hover:bg-canvas-soft-2"
      >
        <span class="body-sm font-medium">Stop</span>
      </button>

      <!-- Record voice test button for instant playback (echo test) -->
      <button
        data-mic-record
        class="inline-flex items-center gap-2 rounded-pill border border-hairline bg-canvas px-4 py-3 sm:py-2.5 text-ink transition-colors hover:bg-canvas-soft-2"
        title="Record a 5-second voice sample and listen back to hear how you sound"
      >
        <span class="size-2.5 rounded-full bg-error" data-rec-indicator></span>
        <span class="body-sm font-medium" data-rec-btn-text>Record voice sample (hear yourself)</span>
      </button>

      <label class="ml-auto flex items-center gap-2">
        <span class="caption-mono uppercase text-mute">Mic</span>
        <select
          data-mic-select
          class="body-sm h-11 rounded-sm border border-hairline bg-canvas px-3 text-ink sm:h-10"
        >
          <option value="">Default microphone</option>
        </select>
      </label>
    </div>

    <!-- Voice Playback Card (Echo Test) -->
    <div data-voice-playback class="mt-6 hidden rounded-lg border border-hairline bg-canvas-soft p-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 class="body-md-strong font-semibold text-ink">Recorded Voice Playback</h3>
          <p class="caption mt-0.5 text-mute">Played back locally through your speakers/headphones. Audio never leaves your device.</p>
        </div>
        <div class="flex items-center gap-2">
          <button
            data-voice-download
            class="caption-mono inline-flex items-center gap-1.5 rounded-pill border border-hairline bg-canvas px-3 py-1.5 text-ink hover:bg-canvas-soft-2"
          >
            Download voice sample
          </button>
          <button
            data-voice-close
            class="caption-mono rounded-full p-1.5 text-mute hover:text-ink"
            aria-label="Close playback card"
          >
            ✕
          </button>
        </div>
      </div>
      <div class="mt-3">
        <audio data-voice-audio controls class="w-full h-10 rounded"></audio>
      </div>
    </div>

    <p data-mic-error class="body-sm mt-4 hidden text-error"></p>
  </div>
</section>

<script>
  import { startMic, type MicSession } from '../../lib/mic';
  import { listDevices, onDeviceChange } from '../../lib/devices';
  import { $, setText } from '../../lib/dom';
  import type { MediaError } from '../../lib/types';

  const root = document.querySelector<HTMLElement>('[data-mic-tool]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const S = JSON.parse(root.dataset.strings || '{}') as Record<string, string>;
    const startBtn = $<HTMLButtonElement>('[data-mic-start]', root)!;
    const stopBtn = $<HTMLButtonElement>('[data-mic-stop]', root)!;
    const recordBtn = $<HTMLButtonElement>('[data-mic-record]', root)!;
    const recBtnText = $('[data-rec-btn-text]', root)!;
    const recIndicator = $('[data-rec-indicator]', root)!;
    const playbackCard = $('[data-voice-playback]', root)!;
    const voiceAudio = $<HTMLAudioElement>('[data-voice-audio]', root)!;
    const voiceDownload = $<HTMLButtonElement>('[data-voice-download]', root)!;
    const voiceClose = $<HTMLButtonElement>('[data-voice-close]', root)!;
    const levelEl = $<HTMLElement>('[data-mic-level]', root)!;
    const statusEl = $('[data-mic-status]', root)!;
    const select = $<HTMLSelectElement>('[data-mic-select]', root)!;
    const errorEl = $('[data-mic-error]', root)!;

    let mic: MicSession | null = null;
    let stopMeter: (() => void) | null = null;
    let mediaRecorder: MediaRecorder | null = null;
    let recordedChunks: Blob[] = [];
    let audioBlobUrl: string | null = null;
    let countdownInterval: number | undefined;

    async function populate() {
      const mics = await listDevices('audioinput');
      const current = select.value;
      select.innerHTML = '';
      if (!mics.length) {
        select.innerHTML = '<option value="">Default microphone</option>';
        return;
      }
      for (const d of mics) {
        const opt = document.createElement('option');
        opt.value = d.deviceId;
        opt.textContent = d.label;
        select.appendChild(opt);
      }
      if (current) select.value = current;
    }

    async function ensureMicRunning(): Promise<boolean> {
      if (mic) return true;
      try {
        errorEl.classList.add('hidden');
        mic = await startMic(select.value || undefined);
        await populate();
        setText(statusEl, S.listening);
        statusEl.classList.remove('text-mute');
        statusEl.classList.add('text-success');
        startBtn.classList.add('hidden');
        startBtn.classList.remove('inline-flex');
        stopBtn.classList.remove('hidden');
        stopBtn.classList.add('inline-flex');
        stopMeter = mic.meter((level) => {
          levelEl.style.width = `${Math.round(level * 100)}%`;
        });
        return true;
      } catch (e) {
        const err = e as MediaError;
        errorEl.textContent = err.message;
        errorEl.classList.remove('hidden');
        return false;
      }
    }

    async function start() {
      teardown();
      await ensureMicRunning();
    }

    function teardown() {
      stopMeter?.();
      stopMeter = null;
      mic?.stop();
      mic = null;
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      window.clearInterval(countdownInterval);
      recIndicator.classList.remove('animate-ping');
      setText(recBtnText, 'Record voice sample (hear yourself)');
    }

    function stop() {
      teardown();
      levelEl.style.width = '0%';
      setText(statusEl, S.idle);
      statusEl.classList.add('text-mute');
      statusEl.classList.remove('text-success');
      stopBtn.classList.add('hidden');
      stopBtn.classList.remove('inline-flex');
      startBtn.classList.remove('hidden');
      startBtn.classList.add('inline-flex');
    }

    async function startVoiceRecording() {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        return;
      }

      const ok = await ensureMicRunning();
      if (!ok || !mic) return;

      recordedChunks = [];
      try {
        const mimeType = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'].find((t) =>
          typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(t)
        ) || '';

        mediaRecorder = mimeType
          ? new MediaRecorder(mic.stream, { mimeType })
          : new MediaRecorder(mic.stream);

        mediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) recordedChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          window.clearInterval(countdownInterval);
          recIndicator.classList.remove('animate-ping');
          setText(recBtnText, 'Record voice sample (hear yourself)');

          if (recordedChunks.length === 0) return;
          const blob = new Blob(recordedChunks, { type: mediaRecorder?.mimeType || 'audio/webm' });
          if (audioBlobUrl) URL.revokeObjectURL(audioBlobUrl);
          audioBlobUrl = URL.createObjectURL(blob);
          voiceAudio.src = audioBlobUrl;
          playbackCard.classList.remove('hidden');
          voiceAudio.play().catch(() => {});
        };

        mediaRecorder.start();
        recIndicator.classList.add('animate-ping');

        let remaining = 5;
        setText(recBtnText, `Recording: speak now (${remaining}s)`);
        countdownInterval = window.setInterval(() => {
          remaining -= 1;
          if (remaining <= 0) {
            window.clearInterval(countdownInterval);
            if (mediaRecorder && mediaRecorder.state === 'recording') {
              mediaRecorder.stop();
            }
          } else {
            setText(recBtnText, `Recording: speak now (${remaining}s)`);
          }
        }, 1000);
      } catch (err) {
        errorEl.textContent = 'Voice recording is not supported in this browser.';
        errorEl.classList.remove('hidden');
      }
    }

    voiceClose.addEventListener('click', () => {
      playbackCard.classList.add('hidden');
      voiceAudio.pause();
    });

    voiceDownload.addEventListener('click', () => {
      if (!audioBlobUrl) return;
      const a = document.createElement('a');
      a.href = audioBlobUrl;
      a.download = `mic-test-${Date.now()}.webm`;
      a.click();
    });

    recordBtn.addEventListener('click', startVoiceRecording);
    startBtn.addEventListener('click', start);
    stopBtn.addEventListener('click', stop);
    select.addEventListener('change', () => {
      if (mic) start();
    });

    window.addEventListener('pagehide', teardown);
    window.addEventListener('beforeunload', teardown);
    document.addEventListener('astro:before-swap', teardown);

    populate();
    onDeviceChange(populate);
  }
</script>
