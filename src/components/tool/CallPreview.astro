---
// The differentiator: every webcam test shows you a big mirrored preview, which
// is the one view nobody else ever sees. This renders the live feed at the sizes
// a call actually uses — and un-mirrored, the way other people see you.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const tiles = [
  // `span` puts the largest tile on its own full-width row on phones; the two
  // small ones then pair up beneath it instead of wrapping at arbitrary points.
  { id: 'speaker', label: 'Speaker view', w: 288, note: 'When you are the one talking', span: true },
  { id: 'gallery', label: 'Gallery tile', w: 168, note: 'In a grid of participants', span: false },
  { id: 'thumb', label: 'Thumbnail', w: 96, note: 'Small grids and sidebars', span: false },
];
---

<div
  data-call-preview
  class:list={['rounded-xl border border-hairline bg-canvas p-4 elev-2 sm:p-5', className]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="display-sm text-ink">How you look on a call</h2>
      <p class="body-sm mt-1 text-body">
        Not mirrored, and at the size people really see — the two things a big preview hides.
      </p>
    </div>
    <span data-call-status class="caption-mono shrink-0 text-mute">Idle</span>
  </div>

  <!--
    These tiles are meant to be the true pixel sizes a call uses, so they must not
    be squeezed. Below 400px a 2-up row would shrink the 168px gallery tile to
    ~156px — no longer an honest gallery tile — and the narrower cell wrapped one
    caption but not the other, so the two labels sat a line apart. One column below
    400px keeps every tile at its real size and the captions trivially aligned;
    from 400px the pair fits at full size and shares a baseline (items-end).
  -->
  <div class="mt-5 grid grid-cols-1 items-end gap-4 min-[400px]:grid-cols-2 sm:flex sm:flex-wrap sm:gap-5">
    {
      tiles.map((t) => (
        <figure class:list={['m-0', t.span && 'min-[400px]:col-span-2 sm:col-span-1']}>
          <div
            class="overflow-hidden rounded-md border border-hairline bg-stage"
            style={`width:min(${t.w}px, 100%)`}
          >
            <video
              data-call-tile={t.id}
              class="block aspect-video w-full object-cover"
              autoplay
              muted
              playsinline
            />
          </div>
          <figcaption class="mt-2">
            <span class="body-sm block font-medium text-ink">{t.label}</span>
            <span class="caption block text-mute">{t.note}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <p data-call-note class="body-sm mt-5 text-body">
    Start the test to see your call-size previews.
  </p>
</div>

<script>
  import { setText } from '../../lib/dom';

  interface StreamDetail {
    stream: MediaStream;
    width: number;
    height: number;
  }

  document.querySelectorAll<HTMLElement>('[data-call-preview]').forEach((root) => {
    const status = root.querySelector('[data-call-status]');
    const note = root.querySelector('[data-call-note]');
    const videos = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-call-tile]'));

    function attach(detail: StreamDetail) {
      for (const v of videos) {
        v.srcObject = detail.stream;
        // Autoplay can reject before a gesture; the stream is muted so this is safe.
        void v.play().catch(() => {});
      }
      setText(status, 'Live');
      status?.classList.remove('text-mute');
      status?.classList.add('text-success');
      setText(note, describe(detail.width, detail.height));
    }

    function detach() {
      for (const v of videos) v.srcObject = null;
      setText(status, 'Idle');
      status?.classList.add('text-mute');
      status?.classList.remove('text-success');
      setText(note, 'Start the test to see your call-size previews.');
    }

    /** Explain what a call does to this particular frame shape. */
    function describe(w: number, h: number): string {
      if (!w || !h) return 'Waiting for the camera…';
      const ratio = w / h;
      const wide = Math.abs(ratio - 16 / 9) < 0.05;
      if (wide) {
        return 'Your camera is already 16:9, so call tiles show your full frame without cropping. Check the thumbnail: if your face is hard to read at that size, move closer to the camera.';
      }
      if (ratio < 16 / 9) {
        return 'Your camera is narrower than 16:9, so widescreen tiles crop the top and bottom of your frame or add bars at the sides. Leave a little headroom so the crop does not clip your forehead.';
      }
      return 'Your camera is wider than 16:9, so tiles trim the sides of your frame. Keep yourself centred to stay in shot.';
    }

    document.addEventListener('webcam:stream', (e) => attach((e as CustomEvent<StreamDetail>).detail));
    document.addEventListener('webcam:stop', detach);
  });
</script>
