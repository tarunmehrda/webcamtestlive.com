---
import Card from '../ui/Card.astro';
import { SITE } from '../../data/site';

const embedSnippet = `<iframe src="${SITE.url}/embed" width="100%" height="560" style="border:0;border-radius:12px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.08);max-width:800px;display:block;margin:0 auto;" allow="camera;microphone" title="Webcam & Mic Test"></iframe>
<p style="font-size:12px;text-align:center;color:#6b7280;margin-top:6px;"><a href="${SITE.url}" target="_blank" rel="noopener" style="color:#2563eb;text-decoration:none;font-weight:500;">Free Webcam Test by WebcamTestLive.com</a></p>`;
---

<div class="mx-auto my-8 max-w-3xl" id="embed-widget">
  <Card class="p-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary">
          <span>&lt;/&gt;</span>
          <span>Free Embed Widget</span>
        </div>
        <h3 class="display-sm mt-2 text-ink">Embed this Webcam Test on Your Website</h3>
        <p class="body-sm mt-1 text-body">
          Allow your visitors, remote workers, students, or interview candidates to test their camera &amp; mic directly on your site.
        </p>
      </div>
      <button
        type="button"
        data-copy-embed
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow transition-transform active:scale-95 hover:opacity-95"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
        <span data-embed-btn-text>Copy Embed Code</span>
      </button>
    </div>

    <div class="relative mt-4">
      <textarea
        readonly
        rows="3"
        data-embed-code
        class="w-full resize-none rounded-lg border border-hairline bg-canvas-soft-1 p-3 font-mono text-xs text-body focus:outline-none"
      >{embedSnippet}</textarea>
    </div>
    
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-mute">
      <span>Requires no server setup · Works in all modern browsers · 100% Client-side</span>
      <a href="/embed" target="_blank" class="font-medium text-primary hover:underline">Preview Embed &rarr;</a>
    </div>
  </Card>
</div>

<script>
  const copyBtn = document.querySelector('[data-copy-embed]');
  const codeArea = document.querySelector('[data-embed-code]') as HTMLTextAreaElement | null;
  const label = document.querySelector('[data-embed-btn-text]');

  if (copyBtn && codeArea && label) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeArea.value);
        label.textContent = 'Copied to Clipboard!';
      } catch {
        codeArea.select();
        label.textContent = 'Press Ctrl+C to Copy';
      }
      setTimeout(() => {
        label.textContent = 'Copy Embed Code';
      }, 2500);
    });
  }
</script>
