---
import { t, localeFromPath } from '../../i18n';

// Second differentiator: where the browser exposes them, these sliders drive the
// camera hardware live. Other test sites report a dark picture; this one lets you
// raise the brightness and watch it change.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const c = t(localeFromPath(Astro.url.pathname)).tool.cameraControls;
---

<div
  data-camera-controls
  data-strings={JSON.stringify({ idle: c.idle, unsupported: c.unsupported, torch: c.torch, on: c.on, off: c.off })}
  class:list={['rounded-xl border border-hairline bg-canvas p-4 elev-2 sm:p-5', className]}
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="display-sm text-ink">{c.title}</h2>
      <p class="body-sm mt-1 text-body">{c.subtitle}</p>
    </div>
    <button
      data-controls-reset
      class="body-sm hidden shrink-0 rounded-pill border border-hairline bg-canvas px-3 py-3 font-medium text-body transition-colors hover:text-ink sm:py-1.5"
    >
      {c.reset}
    </button>
  </div>

  <!--
    Columns, not a stack: six sliders in one column ran to ~700px, which is what
    stretched the row beside the preview and opened half a screen of empty canvas
    under it. Three across at lg, where this card runs the full width of the
    tool, is two rows instead of six. Below lg the card is only half the width,
    so a single column stays right.
  -->
  <div data-controls-list class="mt-4 grid gap-x-6 gap-y-4 lg:grid-cols-3"></div>

  <p data-controls-empty class="body-sm mt-4 text-mute">
    Start the test to see which controls your camera supports.
  </p>
</div>

<script>
  import { readControls, applyControl, resetControls, hasTorch, setTorch, type ControlSpec } from '../../lib/controls';
  import { setText } from '../../lib/dom';

  interface StreamDetail {
    stream: MediaStream;
  }

  document.querySelectorAll<HTMLElement>('[data-camera-controls]').forEach((root) => {
    // Client scripts cannot reach the server-side dictionary, so the component
    // serialises the strings it needs onto the root element.
    const S = JSON.parse(root.dataset.strings || '{}') as Record<string, string>;
    const list = root.querySelector('[data-controls-list]')!;
    const empty = root.querySelector('[data-controls-empty]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-controls-reset]')!;
    let track: MediaStreamTrack | null = null;

    function clear() {
      list.innerHTML = '';
      resetBtn.classList.add('hidden');
    }

    function build(detail: StreamDetail) {
      track = detail.stream.getVideoTracks()[0] ?? null;
      clear();
      if (!track) return;

      const specs = readControls(track);
      const torch = hasTorch(track);

      if (!specs.length && !torch) {
        setText(empty, S.unsupported);
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      resetBtn.classList.remove('hidden');
      for (const spec of specs) list.appendChild(slider(spec));
      if (torch) list.appendChild(torchToggle());
    }

    function slider(spec: ControlSpec): HTMLElement {
      const wrap = document.createElement('div');
      const id = `ctl-${spec.name}`;
      const shown = (v: number) => (spec.unit === '×' ? v.toFixed(1) : Math.round(v).toString());

      wrap.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <label class="caption-mono uppercase text-mute" for="${id}">${spec.label}</label>
          <span class="body-sm font-medium text-ink" data-out>${shown(spec.value)}${spec.unit ?? ''}</span>
        </div>`;

      const input = document.createElement('input');
      input.type = 'range';
      input.id = id;
      input.min = String(spec.min);
      input.max = String(spec.max);
      input.step = String(spec.step);
      input.value = String(spec.value);
      input.className = 'mt-2 h-11 w-full cursor-pointer accent-[var(--color-primary)] sm:h-6';

      const out = wrap.querySelector('[data-out]')!;
      input.addEventListener('input', async () => {
        const v = Number(input.value);
        setText(out, `${shown(v)}${spec.unit ?? ''}`);
        if (track) await applyControl(track, spec.name, v);
      });

      wrap.appendChild(input);
      return wrap;
    }

    function torchToggle(): HTMLElement {
      const wrap = document.createElement('div');
      wrap.className = 'flex items-center justify-between gap-3 self-end pb-2';
      wrap.innerHTML = `<span class="caption-mono uppercase text-mute"></span>`;
      setText(wrap.firstElementChild, S.torch);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('aria-pressed', 'false');
      btn.className =
        'body-sm rounded-pill border border-hairline bg-canvas px-4 py-3 sm:py-2 font-medium text-ink transition-colors hover:bg-canvas-soft-2 aria-pressed:bg-primary aria-pressed:text-on-primary';
      btn.textContent = S.off;
      btn.addEventListener('click', async () => {
        const on = btn.getAttribute('aria-pressed') !== 'true';
        if (track && (await setTorch(track, on))) {
          btn.setAttribute('aria-pressed', String(on));
          btn.textContent = on ? S.on : S.off;
        }
      });
      wrap.appendChild(btn);
      return wrap;
    }

    resetBtn.addEventListener('click', async () => {
      if (!track) return;
      await resetControls(track);
      build({ stream: track ? new MediaStream([track]) : new MediaStream() });
    });

    document.addEventListener('webcam:stream', (e) => build((e as CustomEvent<StreamDetail>).detail));
    document.addEventListener('webcam:stop', () => {
      track = null;
      clear();
      setText(empty, S.idle);
      empty.classList.remove('hidden');
    });
  });
</script>
