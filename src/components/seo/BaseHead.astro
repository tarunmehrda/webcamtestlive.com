---
import { SITE } from '../../data/site';
import { LOCALES, DEFAULT_LOCALE, localePath, localeFromPath, pathWithoutLocale, localeMeta, isTranslatedRoute, type Locale } from '../../i18n';

interface Props {
  title?: string;
  /** Full <title> with no "| Webcam Test" suffix, for pages that own their title. */
  rawTitle?: string;
  description?: string;
  /** Keep a page out of the index (thank-you pages, 404). */
  noindex?: boolean;
  /** JSON-LD objects to embed as structured data. */
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
}

const {
  title,
  rawTitle,
  description = SITE.description,
  noindex = false,
  jsonLd = [],
  locale = localeFromPath(Astro.url.pathname),
} = Astro.props;

const fullTitle =
  rawTitle ?? (title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`);
const routeKey = pathWithoutLocale(Astro.url.pathname);
const translated = isTranslatedRoute(routeKey);

// A localised URL for a route with no real translation is an English fallback
// page. Point its canonical at the English original rather than at itself, so
// the duplicate consolidates instead of competing.
const isFallbackCopy = !translated && locale !== DEFAULT_LOCALE;
// Built with localePath rather than Astro.url.pathname so the canonical is byte
// identical to the matching hreflang href. pathname carries a trailing slash
// (/vi/) while localePath does not (/vi); a canonical that disagrees with its
// own hreflang entry invalidates the set. The no-slash form is also the one the
// Worker serves 200 for: html_handling is "drop-trailing-slash".
const canonical = new URL(
  localePath(isFallbackCopy ? DEFAULT_LOCALE : locale, routeKey),
  SITE.url,
).href;

// hreflang set. Every locale points at the same route in its own prefix, and
// x-default goes to English; Google requires the set to be reciprocal and to
// include a self-reference, so the current page is listed here too. Emitted
// only for routes that really are translated in every locale.
const alternates = translated
  ? LOCALES.map((l) => ({
      hreflang: l.hreflang,
      href: new URL(localePath(l.code, routeKey), SITE.url).href,
    }))
  : [];
const xDefault = new URL(localePath(DEFAULT_LOCALE, routeKey), SITE.url).href;

// og:locale wants POSIX-style underscores (pt_BR), not the BCP 47 hyphen form.
const ogLocale = localeMeta(locale).hreflang.replace('-', '_');
// PNG, not SVG, because social platforms do not render SVG preview images.
const ogImage = new URL('/og-default.png', SITE.url).href;

// Sitewide entity markup. Page-specific graphs are passed in via `jsonLd`.
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: 'Free Online Webcam Test',
  url: SITE.url,
  description: SITE.description,
  inLanguage: locale,
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.url}/#org`,
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: new URL('/web-app-manifest-512x512.png', SITE.url).href },
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Webcam" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>

<!-- hreflang: self-referencing and reciprocal, or Google ignores the whole set. -->
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{!noindex && translated && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:creator" content={SITE.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(siteLd)} />
{
  jsonLd.map((obj) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))
}
