---
import { SITE } from '../../data/site';
import { LOCALES, DEFAULT_LOCALE, localePath, localeFromPath, pathWithoutLocale, localeMeta, isTranslatedRoute, type Locale } from '../../i18n';
import { pageDates } from '../../lib/dates';
import { ORG_ID, WEBSITE_ID } from '../../lib/seo';

interface Props {
  title?: string;
  /** Full <title> with no "| Webcam Test" suffix, for pages that own their title. */
  rawTitle?: string;
  description?: string;
  /** Keep a page out of the index (thank-you pages, 404). */
  noindex?: boolean;
  /** JSON-LD objects to embed as structured data. */
  jsonLd?: Record<string, unknown>[];
  /** Schema.org type of the page node: WebPage, or a subtype such as FAQPage. */
  pageType?: string;
  /** Extra properties merged into the page node, e.g. a FAQPage's mainEntity. */
  pageExtra?: Record<string, unknown>;
  locale?: Locale;
}

const {
  title,
  rawTitle,
  description = SITE.description,
  noindex = false,
  jsonLd = [],
  pageType = 'WebPage',
  pageExtra = {},
  locale = localeFromPath(Astro.url.pathname),
} = Astro.props;

const fullTitle =
  rawTitle ?? (title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`);
const routeKey = pathWithoutLocale(Astro.url.pathname);
const translated = isTranslatedRoute(routeKey);

// A localised URL for a route with no real translation is an English fallback
// page. Point its canonical at the English original rather than at itself, so
// the duplicate consolidates instead of competing.
const isFallbackCopy = !translated && locale !== DEFAULT_LOCALE;
// Built with localePath rather than Astro.url.pathname so the canonical is byte
// identical to the matching hreflang href. pathname carries a trailing slash
// (/vi/) while localePath does not (/vi); a canonical that disagrees with its
// own hreflang entry invalidates the set. The no-slash form is also the one the
// Worker serves 200 for: html_handling is "drop-trailing-slash".
const canonical = new URL(
  localePath(isFallbackCopy ? DEFAULT_LOCALE : locale, routeKey),
  SITE.url,
).href;

// hreflang set. Every locale points at the same route in its own prefix, and
// x-default goes to English; Google requires the set to be reciprocal and to
// include a self-reference, so the current page is listed here too. Emitted
// only for routes that really are translated in every locale.
const alternates = translated
  ? LOCALES.map((l) => ({
      hreflang: l.hreflang,
      href: new URL(localePath(l.code, routeKey), SITE.url).href,
    }))
  : [];
const xDefault = new URL(localePath(DEFAULT_LOCALE, routeKey), SITE.url).href;

const hreflang = localeMeta(locale).hreflang;
// og:locale wants the POSIX language_TERRITORY form (pt_BR), not the BCP 47
// hyphen form, and a bare language code filled out with its main region.
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_US',
  vi: 'vi_VN',
  'pt-br': 'pt_BR',
  ru: 'ru_RU',
  id: 'id_ID',
  hi: 'hi_IN',
};
const ogLocale = OG_LOCALE[locale];
// PNG, not SVG, because social platforms do not render SVG preview images.
const ogImage = new URL('/og-default.png', SITE.url).href;

// Sitewide entity graph, in one block so the nodes can reference each other
// by @id: the Organization that publishes the WebSite that this WebPage is
// part of. Page-specific nodes (tools, articles, FAQs, breadcrumbs) come in
// via `jsonLd` and point back at the same ids.
const dates = pageDates(routeKey);
const logo = new URL('/web-app-manifest-512x512.png', SITE.url).href;

const orgLd = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: SITE.name,
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: logo, width: 512, height: 512 },
  email: SITE.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    url: `${SITE.url}/contact`,
    availableLanguage: LOCALES.map((l) => l.hreflang),
  },
};

const websiteLd = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE.name,
  alternateName: 'Free Online Webcam Test',
  url: SITE.url,
  description: SITE.description,
  inLanguage: LOCALES.map((l) => l.hreflang),
  publisher: { '@id': ORG_ID },
};

// Dated, so a crawler can tell a refreshed guide from a stale one. The dates
// come from git (src/lib/dates.ts) and match the visible "Last updated" line
// on the pages that show one.
const webPageLd = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  isPartOf: { '@id': WEBSITE_ID },
  inLanguage: hreflang,
  datePublished: dates.published,
  dateModified: dates.modified,
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
  publisher: { '@id': ORG_ID },
  ...pageExtra,
};

const siteLd = {
  '@context': 'https://schema.org',
  '@graph': noindex ? [orgLd, websiteLd] : [orgLd, websiteLd, webPageLd],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Webcam" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>

<!-- hreflang: self-referencing and reciprocal, or Google ignores the whole set. -->
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{!noindex && translated && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:creator" content={SITE.twitter} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(siteLd)} />
{
  jsonLd.map((obj) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))
}
