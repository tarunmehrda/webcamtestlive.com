---
import Container from './Container.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SITE } from '../../data/site';
import { localeFromPath, localePath, pathWithoutLocale, t } from '../../i18n';

const path = Astro.url.pathname;
const locale = localeFromPath(path);
const copy = t(locale);
// Nav labels come from the dictionary, and every href is rewritten into the
// active locale's prefix so navigation never drops the visitor back to English.
const NAV = [
  { key: '/', label: copy.nav.home },
  { key: '/resolution', label: copy.nav.resolution },
  { key: '/fps', label: copy.nav.fps },
  { key: '/mic-test', label: copy.nav.micTest },
  { key: '/troubleshooting', label: copy.nav.troubleshooting },
  { key: '/faq', label: copy.nav.faq },
  { key: '/about', label: copy.nav.about },
].map((item) => ({ ...item, href: localePath(locale, item.key) }));

const routeKey = pathWithoutLocale(path);
const isActive = (key: string) => (key === '/' ? routeKey === '/' : routeKey.startsWith(key));
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/80 backdrop-blur-md">
  <Container>
    <nav class="flex h-16 items-center justify-between gap-4">
      <a href={localePath(locale, "/")} class="-my-2 flex items-center gap-2 py-2" aria-label={`${SITE.name} home`}>
        <Logo class="size-7" />
        <span class="body-md-strong font-semibold tracking-tight">Webcam Test</span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {
          NAV.slice(1).map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'body-sm rounded-full px-3 py-2 transition-colors',
                  isActive(item.key)
                    ? 'text-ink'
                    : 'text-body hover:text-ink hover:bg-canvas-soft-2',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <LanguageSwitcher />

        <button
          type="button"
          data-theme-toggle
          aria-label={copy.nav.toggleTheme}
          class="grid size-11 place-items-center rounded-full border border-hairline bg-canvas text-ink transition-colors hover:bg-canvas-soft-2 sm:size-9"
        >
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </button>

        <a
          href={`${localePath(locale, "/")}#test`}
          class="hidden shrink-0 items-center rounded-sm bg-primary px-3 py-1.5 text-on-primary transition-opacity hover:opacity-90 sm:inline-flex"
        >
          <span class="body-sm font-medium">{copy.nav.startTest}</span>
        </a>

        <!-- Mobile menu (native details, zero JS) -->
      <details class="relative lg:hidden">
        <summary
          class="grid size-11 cursor-pointer list-none place-items-center rounded-full border border-hairline bg-canvas sm:size-9 [&::-webkit-details-marker]:hidden"
          aria-label={copy.nav.openMenu}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="18" y2="18" />
          </svg>
        </summary>
        <ul class="elev-4 absolute right-0 top-[calc(100%+8px)] w-56 rounded-md border border-hairline bg-canvas p-1">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'body-sm block rounded-sm px-3 py-3',
                    isActive(item.key) ? 'bg-canvas-soft-2 text-ink' : 'text-body',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
          </ul>
        </details>
      </div>
    </nav>
  </Container>
</header>

<script>
  const KEY = 'wt-theme';
  const root = document.documentElement;
  function apply(dark: boolean) {
    root.classList.toggle('dark', dark);
    try {
      localStorage.setItem(KEY, dark ? 'dark' : 'light');
    } catch {
      /* ignore */
    }
  }
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => apply(!root.classList.contains('dark')));
  });
  // Follow OS changes only when the user hasn't explicitly chosen.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* ignore */
    }
    if (!stored) root.classList.toggle('dark', e.matches);
  });
</script>
