---
import Container from './Container.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}
const { eyebrow, title, subtitle, compact = true } = Astro.props;
---

<section class="relative overflow-hidden border-b border-hairline bg-canvas">
  <div class="mesh-hero pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent to-canvas"></div>
  <Container class={`relative ${compact ? 'py-6 sm:py-8 md:py-10' : 'py-10 sm:py-14 md:py-18'}`}>
    <div class="mx-auto max-w-3xl text-center">
      {eyebrow && <div class="mb-3 flex justify-center sm:mb-4"><Badge tone="live">{eyebrow}</Badge></div>}
      <h1 class="display-xl text-balance text-ink md:text-[clamp(36px,20px+2.5vw,48px)] md:leading-[1.1] md:tracking-[-0.04em]">
        {title}
      </h1>
      {subtitle && <p class="body-md mx-auto mt-2 max-w-2xl text-pretty text-body sm:mt-3 sm:text-balance">{subtitle}</p>}
      <div class="mt-4 sm:mt-5">
        <slot />
      </div>
    </div>
  </Container>
</section>
