---
interface Props {
  title: string;
  href?: string;
  icon?: string;
  /** Localised label for the trailing link. Defaults to English. */
  cta?: string;
}
const { title, href, icon, cta = 'Open tool' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'block rounded-md border border-hairline bg-canvas p-6 elev-2 transition-shadow',
    href && 'hover:elev-4',
  ]}
>
  {
    icon && (
      <span class="mb-4 grid size-9 place-items-center rounded-md bg-canvas-soft-2 text-ink" set:html={icon} />
    )
  }
  <h3 class="display-sm text-ink">{title}</h3>
  <p class="body-sm mt-2 text-body"><slot /></p>
  {
    href && (
      <span class="body-sm mt-4 inline-flex items-center gap-1 font-medium text-link">
        {cta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </span>
    )
  }
</Tag>
