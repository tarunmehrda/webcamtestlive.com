---
interface Props {
  class?: string;
  tone?: 'neutral' | 'live';
}
const { class: className = '', tone = 'neutral' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1',
    tone === 'live'
      ? 'border-success/20 bg-success/10 text-success'
      : 'border-hairline bg-canvas-soft text-body',
    className,
  ]}
>
  {tone === 'live' && <span class="size-1.5 rounded-full bg-success"></span>}
  <span class="caption font-medium"><slot /></span>
</span>
