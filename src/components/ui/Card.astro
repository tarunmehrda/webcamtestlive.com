---
interface Props {
  class?: string;
  elevation?: 2 | 3 | 4;
  soft?: boolean;
}
const { class: className = '', elevation = 3, soft = false } = Astro.props;
const elev = { 2: 'elev-2', 3: 'elev-3', 4: 'elev-4' }[elevation];
---

<div
  class:list={[
    'rounded-lg border border-hairline',
    soft ? 'bg-canvas-soft' : 'bg-canvas',
    elev,
    className,
  ]}
>
  <slot />
</div>
