---
import '../styles/global.css';
// ?url gives the hashed asset URL so the preload matches the file the CSS loads.
// Only the latin face: it is the one every page paints with; the other subsets
// stay lazy behind their unicode-range.
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import BaseHead from '../components/seo/BaseHead.astro';
import { localeFromPath, localeMeta, type Locale } from '../i18n';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  rawTitle?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
}

const { title, rawTitle, description, noindex, jsonLd } = Astro.props;
// Pages under /[lang]/ pass their locale explicitly; the English pages at the
// root leave it undefined and fall back to reading it off the URL.
const locale: Locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const { hreflang, dir } = localeMeta(locale);
---

<!doctype html>
<html lang={hreflang} dir={dir}>
  <head>
    <BaseHead title={title} rawTitle={rawTitle} description={description} noindex={noindex} jsonLd={jsonLd} locale={locale} />
    <!-- Without this, font-display:swap paints system-ui first and the page
         visibly re-aligns when Inter lands. crossorigin is required: font
         requests are CORS-mode, and a mismatched preload is fetched twice. -->
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply theme before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem('wt-theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
